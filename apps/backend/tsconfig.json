{
    "extends": "@helpdesk-portal/typescript-config/fastify",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
        "allowJs": true,
        "checkJs": false,
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src"],
    "exclude": ["dist", "node_modules"]
}
