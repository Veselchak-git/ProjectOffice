{
    "name": "backend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:seed": "prisma db seed",
        "prisma:studio": "prisma studio",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "build": "tsc -p tsconfig.build.json",
        "lint": "eslint .",
        "format": "prettier --write .",
        "type-check": "tsc --noEmit -p tsconfig.json",
        "test": "vitest"
    },
    "dependencies": {
        "@fastify/cookie": "^11.1.0",
        "@fastify/env": "7.0.0",
        "@fastify/jwt": "10.1.0",
        "@fastify/type-provider-typebox": "6.1.0",
        "@prisma/adapter-pg": "7.8.0",
        "@prisma/client": "7.8.0",
        "argon2": "0.44.0",
        "fastify": "5.8.5",
        "fastify-plugin": "6.0.0",
        "ms": "^2.1.3",
        "pg": "8.21.0",
        "typebox": "1.2.8",
        "vite": "8.0.16"
    },
    "devDependencies": {
        "@helpdesk-portal/eslint-config": "*",
        "@helpdesk-portal/prettier-config": "*",
        "@helpdesk-portal/typescript-config": "*",
        "@helpdesk-portal/vite-config": "*",
        "@types/ms": "^2.1.0",
        "@types/node": "24.12.3",
        "dotenv": "17.4.2",
        "pino-pretty": "13.1.3",
        "prisma": "7.8.0",
        "tsx": "4.22.4",
        "typescript": "6.0.3"
    }
}
