    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.build.json",
        "type-check": "tsc --noEmit -p tsconfig.json",
        "lint": "eslint .",
        "test": "vitest run"
