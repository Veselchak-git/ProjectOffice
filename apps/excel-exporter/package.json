        "exceljs": "4.4.0",
        "fastify-plugin": "6.0.0"
    },
    "devDependencies": {
        "@helpdesk-portal/eslint-config": "*",
        "@helpdesk-portal/typescript-config": "*",
        "@types/node": "24.12.3",
        "tsx": "4.22.4",
        "typescript": "6.0.3",
        "vitest": "4.1.8"
